<Window x:Class="WindowsXIVAuthenticator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="340"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="RoundedSettingsButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Background"
                    Value="#F2F2F2"/>

            <Setter Property="BorderBrush"
                    Value="#B8B8B8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Launcher section -->
        <TextBlock
            Grid.Row="0"
            Text="XIVLauncher location"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,14"/>

        <TextBox
            x:Name="LauncherPathTextBox"
            Grid.Row="1"
            Height="34"
            FontSize="13"
            VerticalContentAlignment="Center"
            IsReadOnly="True"/>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,12,0,0">

            <Button
                Style="{StaticResource RoundedSettingsButton}"
                Content="Browse..."
                Width="100"
                Margin="0,0,8,0"
                Click="Browse_Click"/>

            <Button
                Style="{StaticResource RoundedSettingsButton}"
                Content="Use default"
                Width="110"
                Click="UseDefault_Click"/>

        </StackPanel>

        <!-- Security section -->
        <StackPanel
            Grid.Row="3"
            Margin="0,22,0,0">

            <TextBlock
                Text="Security"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,0,0,10"/>

            <CheckBox
                x:Name="RequireWindowsHelloCheckBox"
                Content="Require Windows Hello before revealing or sending OTP"
                FontSize="13"
                VerticalAlignment="Center"
                Checked="RequireWindowsHello_Checked"
                Unchecked="RequireWindowsHello_Unchecked"/>

        </StackPanel>

        <TextBlock
            Grid.Row="4"
            x:Name="StatusTextBlock"
            Margin="0,18,0,0"
            FontSize="12"
            TextWrapping="Wrap"
            Opacity="0.70"/>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Style="{StaticResource RoundedSettingsButton}"
                Content="Close"
                Width="90"
                IsDefault="True"
                Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>