<Window x:Class="WindowsXIVAuthenticator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="260"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="XIVLauncher location"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,14"/>

        <TextBox
            x:Name="LauncherPathTextBox"
            Grid.Row="1"
            Height="34"
            VerticalContentAlignment="Center"
            IsReadOnly="True"/>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,12,0,0">

            <Button
                Content="Browse..."
                Width="100"
                Height="34"
                Margin="0,0,10,0"
                Click="Browse_Click"/>

            <Button
                Content="Use default"
                Width="110"
                Height="34"
                Click="UseDefault_Click"/>
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusTextBlock"
            Margin="0,14,0,0"
            TextWrapping="Wrap"
            Opacity="0.75"/>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">

            <Button
                Content="Close"
                Width="90"
                Height="34"
                IsDefault="True"
                Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>