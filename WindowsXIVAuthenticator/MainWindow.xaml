<Window x:Class="WindowsXIVAuthenticator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows XIV Authenticator"
        Height="500"
        Width="760"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Width="56"
                Height="56"
                CornerRadius="28"
                Margin="0,0,14,0"
                VerticalAlignment="Center">

                <Image
                    Source="/Assets/jss-logo.png"
                    Stretch="Uniform"/>
            </Border>

<StackPanel
    Grid.Column="1"
    VerticalAlignment="Center">

    <TextBlock
        Text="JSS Software"
        FontSize="13"
        FontWeight="SemiBold"
        Opacity="0.65"/>

        <TextBlock
            FontSize="13"
            Margin="0,1,0,0">

            <Hyperlink
                NavigateUri="https://xivmods.com/"
                RequestNavigate="Hyperlink_RequestNavigate">
                XIV Mods
            </Hyperlink>

        </TextBlock>

        <TextBlock
            Text="Windows XIV Authenticator"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,2,0,0"/>

    </StackPanel>
        </Grid>

        <!-- Secret input -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,18">

            <TextBlock
                Text="Base32 secret"
                Margin="0,0,0,6"/>

            <TextBox
                x:Name="SecretTextBox"
                Height="34"
                FontSize="15"
                VerticalContentAlignment="Center"/>

        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left controls -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Top">

                <Button
                    Content="Generate OTP"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Click="GenerateOtp_Click"/>

                <Button
                    Content="Import QR Image"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Click="ImportQr_Click"/>

                <Button
                    Content="Send to XIVLauncher"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Click="SendToLauncher_Click"/>

                <Button
                    Content="Launch XIV"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Click="LaunchXiv_Click"/>

                <Button
                    Content="Settings"
                    Width="170"
                    Height="34"
                    HorizontalAlignment="Left"
                    Click="Settings_Click"/>

                <Button
                    Content="Test Windows Hello"
                    Click="TestWindowsHello_Click"
                    Margin="0,10,0,0"
                    Padding="12,6" />
            </StackPanel>

            <!-- Right OTP panel -->
            <Border
                Grid.Column="2"
                Padding="22"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="10"
                VerticalAlignment="Top">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Current OTP"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Opacity="0.65"
                        Margin="0,0,0,6"/>

                    <TextBlock
                        x:Name="OtpTextBlock"
                        Grid.Row="1"
                        Text="------"
                        FontSize="46"
                        FontWeight="Bold"
                        Margin="0,0,0,18"/>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Grid
                            Width="60"
                            Height="60">

                            <Ellipse
                                Stroke="#33000000"
                                StrokeThickness="4"/>

                            <Path
                                x:Name="CountdownPath"
                                Stroke="DodgerBlue"
                                StrokeThickness="4"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"/>

                            <TextBlock
                                x:Name="CountdownTextBlock"
                                Text=""
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>

                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Refresh timer"
                                FontSize="12"
                                Opacity="0.65"/>

                            <TextBlock
                                x:Name="RemainingTextBlock"
                                Text=""
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,4,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- Footer -->
        <TextBlock
            Grid.Row="3"
            FontSize="11"
            Opacity="0.75"
            HorizontalAlignment="Center"
            Margin="0,18,0,0">

            <Run Text="JSS Software • "/>
            <Run Text="Unofficial community tool • "/>

            <Hyperlink
                NavigateUri="https://github.com/JoeSparkx/WindowsXIV-Authenticator"
                RequestNavigate="Hyperlink_RequestNavigate">
                GitHub
            </Hyperlink>

        </TextBlock>

    </Grid>
</Window>